node_modules/
dist/
tsconfig.tsbuildinfo

# secrets — .env.example 만 커밋한다
.env
.env.*
!.env.example

# 개인 설정 (팀 공유 대상 아님)
.claude/settings.local.json

# phase execution outputs
phases/**/phase*-output.json
phases/**/step*-output.json

# 원본 PDF (17MB). 추출본 docs/source/concepts-raw.md 도 아래에서 무시한다(ADR-009).
*.pdf

# 에이전트별 worktree (저장소 안에 만들 경우). 커밋 대상이 아니다.
.claude/worktrees/

# python 부산물
__pycache__/
*.pyc
.pytest_cache/

# 재작성 중간 산출물 (로컬 대조용, 커밋 대상 아님)
phases/**/step*-facts.md

# 외부 참고 자료 추출본. 개념 본문은 ADR-009에 따라 직접 쓴 문장으로 대체됐다.
# 로컬에만 두고 저장소에는 넣지 않는다.
docs/source/concepts-raw.md

# 키워드 퀴즈의 평문. 원문 그대로라 로컬에만 두고, 암호문(src/data/aws/keywords.enc.json)만 커밋한다(ADR-040).
docs/source/keywords-raw.json

# pypdfium2 설치용 가상환경. 덤프 추출 스크립트에만 쓴다.
.venv/

# 880문항 덤프 슬라이스와 개념 인덱스. 스크립트로 재생성되는 파생물이고,
# 슬라이스는 덤프 전문이라 저장소에 넣지 않는다 (concepts-raw.md와 같은 취급).
docs/source/dump-slices/
docs/source/concept-index.md
